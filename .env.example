SECRET_KEY_BASE=generate_one_by_executing_mix_phx.gen.secret
TOKEN_SIGNING_SECRET=generate_one_by_executing_mix_phx.gen.secret

MIX_OS_DEPS_COMPILE_PARTITION_COUNT=12

# OIDC SSO is OPTIONAL and a COMPILE-TIME decision.
# When enabled, ALL of the following variables must be set.
OIDC_ENABLED=true

# Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=https://auth.zebbra.ch
OIDC_CLIENT_ID=the_client_id
OIDC_CLIENT_SECRET=not_used_with_pkce
OIDC_REDIRECT_URI=http://localhost:4000/auth/user/sso/callback

# Optional: extra trusted audiences (comma-separated); Zitadel needs the project id here, Entra ID needs none.
OIDC_TRUSTED_AUDIENCES=the_zitadel_project_id

SENTRY_DSN=sentry_dsn_uri
SENTRY_ENVIRONMENT=dev or staging or prod

BASE_URL=https://my-app.zebbra.ch
