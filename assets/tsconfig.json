// This file is needed on most editors to enable the intelligent autocompletion
// of LiveView's JavaScript API methods. You can safely delete it if you don't need it.
//
// Types for the Phoenix JavaScript assets come from the @types/phoenix devDependency
// in package.json. LiveView types are resolved straight from the phoenix_live_view hex
// dependency's own bundled types below — it ships a real `ViewHook` class (subclassable,
// with typed lifecycle callbacks) that the community @types/phoenix_live_view package
// (stuck at 1.0.0) doesn't model.
//
// Feel free to adjust this configuration however you need.
{
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    // Hex deps are linked into node_modules, so their declaration files land in
    // the program; live_toast ships one that cannot resolve its own imports.
    "skipLibCheck": true,
    "paths": {
      // Bun reads these mappings when bundling too, so `@/*` replaces the
      // `--alias:@=.` flag esbuild needed for colocated hooks importing `@/js/*`.
      "@/*": ["./*"],
      "phoenix": ["./node_modules/@types/phoenix"]
    }
  },
  // Colocated hooks are extracted into the build directory at compile time, so
  // `mix compile` has to run before the `typecheck` script sees them.
  "include": ["js/**/*", "../_build/*/phoenix-colocated/my_app/**/*.ts"]
}
